<Window x:Class="GUI.ProyectosRecientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualIoT - Proyectos recientes"
        Height="680"
        Width="1040"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#0E1117"
        FontFamily="Segoe UI"
        FontSize="13.5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151A22" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B222D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#28C7A4" />
        <SolidColorBrush x:Key="IndustrialYellowBrush" Color="#F7C948" />
        <SolidColorBrush x:Key="IndustrialOrangeBrush" Color="#F97316" />
        <SolidColorBrush x:Key="TextBrush" Color="#EEF4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA0B3" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.28" Color="#000000" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#1C2A3D" />
            <Setter Property="BorderBrush" Value="#35506F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#244464" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#22D3EE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#102033" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#2B3A51" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080C12" Offset="0" />
                <GradientStop Color="#101722" Offset="0.45" />
                <GradientStop Color="#08111C" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111721" BorderBrush="#243044" BorderThickness="0,0,0,1" Effect="{StaticResource SoftShadow}">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Centro de Proyectos" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource IndustrialYellowBrush}" />
                    <TextBlock x:Name="UsuarioTextBlock" Text="Usuario" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Cerrar sesion"
                        Click="LogoutButton_Click"
                        Background="#3B1D1D"
                        BorderBrush="#F97316"
                        Foreground="#FED7AA"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#243044" BorderThickness="1" CornerRadius="10" Padding="14" Effect="{StaticResource SoftShadow}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Proyectos" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Lineas industriales del usuario autenticado" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProjectNameTextBox" Text="Nueva linea industrial" />
                            <Button Grid.Column="2" Content="Crear" Click="CreateProjectButton_Click" />
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="ProjectsListBox"
                             ItemsSource="{Binding Projects}"
                             SelectionChanged="ProjectsListBox_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1B2430" BorderBrush="#34465E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="125" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Text="{Binding FechaTexto}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding DashboardCountText}" Foreground="#28C7A4" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <Button Grid.Column="1" Grid.RowSpan="3" Content="Abrir Proyecto" Tag="{Binding}" Click="OpenProjectButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#243044" BorderThickness="1" CornerRadius="10" Padding="14" Effect="{StaticResource SoftShadow}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedProjectTextBlock" Text="Dashboards del proyecto" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Abre o crea una vista SCADA persistente" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Nuevo Dashboard" Click="CreateDashboardButton_Click" />
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="DashboardsListBox"
                             ItemsSource="{Binding Dashboards}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1B2430" BorderBrush="#34465E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FechaTexto}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding WidgetCountText}" Foreground="#8FA0B3" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Abrir Dashboard" Tag="{Binding}" Click="OpenDashboardButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111721" BorderBrush="#243044" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Listo" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="18,0" />
        </Border>
    </Grid>
</Window>
