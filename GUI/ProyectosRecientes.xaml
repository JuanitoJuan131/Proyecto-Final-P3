<Window x:Class="GUI.ProyectosRecientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualIoT - Centro de Proyectos"
        Height="720"
        Width="1180"
        MinHeight="620"
        MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#071019"
        FontFamily="Segoe UI"
        FontSize="13.5">
    <Window.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="#071019" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C141E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#101923" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#152231" />
        <SolidColorBrush x:Key="CardBrush" Color="#13202C" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#182A3B" />
        <SolidColorBrush x:Key="LineBrush" Color="#26384C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#28C7A4" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="IndustrialYellowBrush" Color="#F7C948" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F97316" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F7FB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A7B7C8" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#72849A" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.28" Color="#000000" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.22" Color="#000000" />
        <DropShadowEffect x:Key="AccentGlow" BlurRadius="18" Direction="0" ShadowDepth="0" Opacity="0.38" Color="#28C7A4" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#1C2A3A" />
            <Setter Property="BorderBrush" Value="#35506F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#23435D" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#102033" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="BorderBrush" Value="#2DD4BF" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#111D2A" />
            <Setter Property="BorderBrush" Value="#2A3C51" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B1D24" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FECACA" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Background" Value="#0B1420" />
            <Setter Property="BorderBrush" Value="#2C4056" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldChrome" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="FieldChrome" Property="Background" Value="#0E1A28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="CleanListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#061019" Offset="0" />
                <GradientStop Color="#0A1622" Offset="0.46" />
                <GradientStop Color="#07121B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="#1D2C3D"
                    BorderThickness="0,0,1,0"
                    Padding="22"
                    Effect="{StaticResource SoftShadow}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,18">
                            <Ellipse Fill="#102538" Stroke="#2DD4BF" StrokeThickness="1.2" />
                            <TextBlock Text="&#xE950;" Style="{StaticResource IconText}" FontSize="22" Effect="{StaticResource AccentGlow}" />
                        </Grid>
                        <TextBlock Text="VisualIoT SCADA" FontSize="22" FontWeight="Bold" Foreground="{StaticResource IndustrialYellowBrush}" />
                        <TextBlock Text="Centro de Proyectos" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,22" />

                        <Border Background="#0E1B28" BorderBrush="#26384C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="OPERADOR" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="UsuarioTextBlock" Text="Usuario" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F1F2D" BorderBrush="#1E3A4F" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="#123A35" CornerRadius="6">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="14" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Workspace activo" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WorkspaceStatsTextBlock" Text="Sin datos cargados" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel>
                            <Border Background="#132231" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#25394E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBlueBrush}" />
                                    <TextBlock Grid.Column="1" Text="Proyectos industriales" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <Border Background="#0C1722" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#1E2C3A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" Foreground="{StaticResource DimTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="Dashboards SCADA" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                            <Border Background="#0C1722" CornerRadius="8" Padding="12" BorderBrush="#1E2C3A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource DimTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="Reglas y monitoreo" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Click="LogoutButton_Click"
                            Style="{StaticResource DangerButton}"
                            Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cerrar sesion" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0D1824" BorderBrush="#21364C" BorderThickness="1" CornerRadius="10" Padding="18" Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Centro de Proyectos" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Gestiona lineas industriales, dashboards persistentes y vistas SCADA/IoT." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#102538" BorderBrush="#254B64" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE95E;" Style="{StaticResource IconText}" Foreground="{StaticResource IndustrialYellowBrush}" FontSize="20" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Modo industrial" FontWeight="SemiBold" />
                                    <TextBlock Text="Dark UI revisado" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource SoftShadow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Proyectos" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ProjectsSummaryTextBlock" Text="Lineas industriales del usuario autenticado" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#123A35" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="ONLINE" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProjectNameTextBox" Text="Nueva linea industrial" />
                                    <Button Grid.Column="2" Click="CreateProjectButton_Click" Style="{StaticResource PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Crear" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <ListBox x:Name="ProjectsListBox"
                                     ItemsSource="{Binding Projects}"
                                     SelectionChanged="ProjectsListBox_SelectionChanged"
                                     Style="{StaticResource CleanListBox}"
                                     ItemContainerStyle="{StaticResource CleanListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ProjectCard"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="#31475E"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,0,12"
                                                Effect="{StaticResource CardShadow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="108" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36" Height="36" Background="#102D39" BorderBrush="#245A66" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBlueBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FechaTexto}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                        <Border Background="#102F2B" BorderBrush="#236E62" BorderThickness="1" CornerRadius="12" Padding="9,4">
                                                            <TextBlock Text="{Binding DashboardCountText}" Foreground="#8EF6D2" FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="#1C2634" BorderBrush="#33485F" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="7,0,0,0">
                                                            <TextBlock Text="SCADA" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Tag="{Binding}"
                                                        Click="OpenProjectButton_Click"
                                                        Style="{StaticResource QuietButton}"
                                                        MinHeight="34"
                                                        Padding="10,6"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Abrir" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="ProjectCard" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                <Setter TargetName="ProjectCard" Property="BorderBrush" Value="#38BDF8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="ProjectCard" Property="Background" Value="#152D3C" />
                                                <Setter TargetName="ProjectCard" Property="BorderBrush" Value="#28C7A4" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Effect="{StaticResource SoftShadow}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="174" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SelectedProjectTextBlock" Text="Dashboards del proyecto" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardsSummaryTextBlock" Text="Abre o crea una vista SCADA persistente" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="CreateDashboardButton_Click" Style="{StaticResource PrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Dashboard" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListBox x:Name="DashboardsListBox"
                                     ItemsSource="{Binding Dashboards}"
                                     Style="{StaticResource CleanListBox}"
                                     ItemContainerStyle="{StaticResource CleanListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="DashboardCard"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="#31475E"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,0,12"
                                                Effect="{StaticResource CardShadow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="126" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36" Height="36" Background="#182A25" BorderBrush="#287464" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FechaTexto}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#102F2B" BorderBrush="#236E62" BorderThickness="1" CornerRadius="12" Padding="9,4">
                                                            <TextBlock Text="{Binding WidgetCountText}" Foreground="#8EF6D2" FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Grid.Column="2" Background="#1F2937" BorderBrush="#3B4D63" BorderThickness="1" CornerRadius="12" Padding="9,4">
                                                            <TextBlock Text="Persistente" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Tag="{Binding}"
                                                        Click="OpenDashboardButton_Click"
                                                        Style="{StaticResource QuietButton}"
                                                        MinHeight="34"
                                                        Padding="10,6"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Abrir" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="DashboardCard" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                <Setter TargetName="DashboardCard" Property="BorderBrush" Value="#28C7A4" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#0B141E" BorderBrush="#1E2C3A" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Listo" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Sistema listo" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
