<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VisualIoT - Monitoreo Industrial"
        Height="820"
        Width="1360"
        MinHeight="620"
        MinWidth="940"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#0E1117"
        FontFamily="Segoe UI"
        FontSize="13.5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151A22" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B222D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#28C7A4" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4FA3FF" />
        <SolidColorBrush x:Key="IndustrialYellowBrush" Color="#F7C948" />
        <SolidColorBrush x:Key="IndustrialOrangeBrush" Color="#F97316" />
        <SolidColorBrush x:Key="TextBrush" Color="#EEF4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA0B3" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.28" Color="#000000" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#1C2A3D" />
            <Setter Property="BorderBrush" Value="#35506F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.2" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#244464" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#22D3EE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#102033" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#2B3A51" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#C8D3DF" />
            <Setter Property="Background" Value="#162131" />
            <Setter Property="BorderBrush" Value="#2B3A51" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#2B3A51" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080C12" Offset="0" />
                <GradientStop Color="#101722" Offset="0.45" />
                <GradientStop Color="#08111C" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="106" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111721" BorderBrush="#243044" BorderThickness="0,0,0,1" Effect="{StaticResource SoftShadow}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="VisualIoT SCADA" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource IndustrialYellowBrush}" />
                    <TextBlock x:Name="ProjectNameHeaderTextBlock" Text="Linea de jugos naturales" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Broker" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                    <TextBox x:Name="BrokerTextBox" Text="broker.hivemq.com" Width="210" Margin="0,0,14,0" />
                    <TextBlock Text="Puerto" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                    <TextBox x:Name="PortTextBox" Text="1883" Width="82" Margin="0,0,14,0" />
                    <TextBlock Text="Topic" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                    <TextBox x:Name="TopicTextBox" Text="visualiot/#" Width="180" Margin="0,0,14,0" />
                </StackPanel>

                <WrapPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Button x:Name="ConnectButton" Content="Conectar" Click="ConnectButton_Click" Width="94" Margin="0,0,8,0" />
                    <Button x:Name="SimulationButton" Content="Iniciar simulacion" Click="SimulationButton_Click" Width="150" Margin="0,0,8,0" />
                    <Button x:Name="NewDashboardButton" Content="Nuevo" Click="NewDashboardButton_Click" Width="96" Margin="0,0,8,0" />
                    <Button x:Name="SaveDashboardButton" Content="Guardar Dashboard" Click="SaveDashboardButton_Click" Width="166" Margin="0,0,8,0" />
                    <Button x:Name="AutomationButton" Content="Automatizacion" Click="AutomationButton_Click" Width="144" Margin="0,0,8,0" />
                </WrapPanel>

                <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="DashboardNameHeaderTextBlock" Text="Dashboard principal" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedMotorHeaderTextBlock" Text="Motor: MOTOR_01" Foreground="#C8D3DF" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionStatusTextBlock" Text="MQTT desconectado" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#243044" BorderThickness="0,0,1,0" Effect="{StaticResource SoftShadow}">
                <DockPanel Margin="14">
                    <Button DockPanel.Dock="Bottom"
                            x:Name="BackToProjectsButton"
                            Content="&lt;&lt; Proyectos"
                            Click="BackToProjectsButton_Click"
                            Margin="0,14,0,0"
                            Background="#2A2415"
                            BorderBrush="#F7C948"
                            Foreground="#FDE68A" />
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="Panel SCADA" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Widgets industriales" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <ListBox x:Name="WidgetPalette"
                             ItemsSource="{Binding WidgetPaletteItems}"
                             PreviewMouseMove="WidgetPalette_PreviewMouseMove"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1B2430" BorderBrush="#34465E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.18" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="168" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#101722" BorderBrush="#243044" BorderThickness="0,0,0,1">
                    <ItemsControl x:Name="MotorCards" ItemsSource="{Binding Motors}" Margin="14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{Binding SelectionBrush}"
                                        BorderThickness="{Binding SelectionThickness}"
                                        CornerRadius="8"
                                        Margin="0,0,10,0"
                                        Padding="12"
                                        Tag="{Binding Id}"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="MotorCard_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Line}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,10,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RpmText}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="RPM" Foreground="White" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TemperatureText}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="Temperatura" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Efficiency}" Height="7" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Grid.Row="1" Background="#0E1117">
                    <Grid>
                        <Canvas x:Name="DashboardCanvas"
                                AllowDrop="True"
                                Drop="DashboardCanvas_Drop"
                                DragOver="DashboardCanvas_DragOver"
                                MouseMove="DashboardCanvas_MouseMove"
                                MouseLeftButtonUp="DashboardCanvas_MouseLeftButtonUp">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,88,88" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#0E1117">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#243044" Thickness="0.8" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="0,0" EndPoint="88,0" />
                                                    <LineGeometry StartPoint="0,0" EndPoint="0,88" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                        </Canvas>
                        <TextBlock x:Name="EmptyDashboardText"
                                   Text="Arrastra widgets aqui"
                                   Foreground="#536579"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#243044" BorderThickness="1,0,0,0" Width="250" Effect="{StaticResource SoftShadow}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="303"/>
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Telemetria" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Tags recibidos en tiempo real" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="TagsGrid"
                              ItemsSource="{Binding Tags}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="#101722"
                              Foreground="{StaticResource TextBrush}"
                              RowBackground="#101722"
                              AlternatingRowBackground="#151D29"
                              BorderBrush="#2B3A51"
                              CanUserResizeRows="False" Margin="10,0,10,0" Grid.RowSpan="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="#101722" BorderBrush="#34465E" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Eventos" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ListBox x:Name="EventsList"
                                     ItemsSource="{Binding Events}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111721" BorderBrush="#243044" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusBarTextBlock"
                       Text="Listo"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="14,0" />
        </Border>

        <Border x:Name="AlertPopup"
                Grid.RowSpan="3"
                Width="420"
                MinHeight="88"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,86,28,0"
                Background="#2A1111"
                BorderBrush="#EF4444"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Opacity="0"
                Visibility="Collapsed"
                Effect="{StaticResource SoftShadow}">
            <StackPanel>
                <TextBlock x:Name="AlertTitleTextBlock" Text="ALERTA INDUSTRIAL" FontSize="15" FontWeight="Bold" Foreground="#FEE2E2" />
                <TextBlock x:Name="AlertMessageTextBlock" Text="Evento de automatizacion" TextWrapping="Wrap" Foreground="#FFE4E6" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
