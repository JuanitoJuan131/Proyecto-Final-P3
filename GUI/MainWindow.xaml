<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VisualIoT - Monitoreo Industrial"
        Height="820"
        Width="1360"
        MinHeight="720"
        MinWidth="1180"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#0E1117"
        FontFamily="Segoe UI"
        FontSize="13.5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151A22" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B222D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#28C7A4" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4FA3FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#EEF4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA0B3" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#243044" />
            <Setter Property="BorderBrush" Value="#33455F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#2B3A51" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="#EEF4F8" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#2B3A51" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111721" BorderBrush="#243044" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VisualIoT" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProjectNameHeaderTextBlock" Text="Linea de jugos naturales" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Broker" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="BrokerTextBox" Text="broker.hivemq.com" Width="190" Margin="0,0,10,0" />
                    <TextBlock Text="Puerto" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="PortTextBox" Text="1883" Width="70" Margin="0,0,10,0" />
                    <TextBlock Text="Topic" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="TopicTextBox" Text="visualiot/#" Width="145" Margin="0,0,10,0" />
                    <Button x:Name="ConnectButton" Content="Conectar MQTT" Click="ConnectButton_Click" />
                    <Button x:Name="SimulationButton" Content="Detener simulacion" Click="SimulationButton_Click" Margin="8,0,0,0" />
                    <Button x:Name="NewDashboardButton" Content="Nuevo dashboard" Click="NewDashboardButton_Click" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="DashboardNameHeaderTextBlock" Text="Dashboard principal" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionStatusTextBlock" Text="MQTT desconectado" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#243044" BorderThickness="0,0,1,0">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="Widgets" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Arrastra al dashboard" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <ListBox x:Name="WidgetPalette"
                             ItemsSource="{Binding WidgetPaletteItems}"
                             PreviewMouseMove="WidgetPalette_PreviewMouseMove"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1B2430" BorderBrush="#2B3A51" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="168" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#101722" BorderBrush="#243044" BorderThickness="0,0,0,1">
                    <ItemsControl x:Name="MotorCards" ItemsSource="{Binding Motors}" Margin="14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="#2B3A51" BorderThickness="1" Margin="0,0,10,0" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Line}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,10,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RpmText}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="RPM" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TemperatureText}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="Temperatura" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Efficiency}" Height="7" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Grid.Row="1" Background="#0E1117">
                    <Grid>
                        <Canvas x:Name="DashboardCanvas"
                                AllowDrop="True"
                                Drop="DashboardCanvas_Drop"
                                DragOver="DashboardCanvas_DragOver"
                                MouseMove="DashboardCanvas_MouseMove"
                                MouseLeftButtonUp="DashboardCanvas_MouseLeftButtonUp">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,88,88" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#0E1117">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#243044" Thickness="0.8" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="0,0" EndPoint="88,0" />
                                                    <LineGeometry StartPoint="0,0" EndPoint="0,88" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                        </Canvas>
                        <TextBlock x:Name="EmptyDashboardText"
                                   Text="Arrastra widgets aqui"
                                   Foreground="#536579"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#243044" BorderThickness="1,0,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Telemetria" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Tags recibidos en tiempo real" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,10" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="TagsGrid"
                              ItemsSource="{Binding Tags}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="#101722"
                              Foreground="{StaticResource TextBrush}"
                              RowBackground="#101722"
                              AlternatingRowBackground="#151D29"
                              BorderBrush="#2B3A51"
                              CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#101722" BorderBrush="#2B3A51" BorderThickness="1" Margin="0,12,0,0" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Eventos" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ListBox x:Name="EventsList"
                                     ItemsSource="{Binding Events}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111721" BorderBrush="#243044" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusBarTextBlock"
                       Text="Listo"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="14,0" />
        </Border>

        <Border x:Name="CreationOverlay"
                Grid.RowSpan="3"
                Panel.ZIndex="20"
                Background="#0B1018">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B1018" Offset="0" />
                        <GradientStop Color="#101827" Offset="0.56" />
                        <GradientStop Color="#0A1420" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="720" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Column="1"
                        Grid.Row="1"
                        Background="#121A27"
                        BorderBrush="#315070"
                        BorderThickness="1"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#172235" BorderBrush="#315070" BorderThickness="0,0,0,1" Padding="28,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Crear espacio de trabajo" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="Configura el proyecto y el dashboard inicial para la linea de produccion."
                                               Foreground="#B7C6D8"
                                               FontSize="15"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#0D9488"
                                        Padding="14,8"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="MQTT READY" FontWeight="Bold" FontSize="12" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Nombre del proyecto" Foreground="#B7C6D8" FontWeight="SemiBold" Margin="0,0,0,7" />
                                        <TextBox x:Name="ProjectNameTextBox" Text="Linea de jugos naturales" FontSize="15" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nombre del dashboard" Foreground="#B7C6D8" FontWeight="SemiBold" Margin="0,0,0,7" />
                                        <TextBox x:Name="DashboardNameTextBox" Text="Monitoreo de motores" FontSize="15" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Plantilla inicial" Foreground="#B7C6D8" FontWeight="SemiBold" Margin="0,18,0,7" />
                                <ComboBox x:Name="DashboardTemplateComboBox"
                                          SelectedIndex="0"
                                          FontSize="15"
                                          Margin="0,0,0,22" Foreground="#FF010406">
                                    <ComboBoxItem Content="Linea de produccion con widgets base" />
                                    <ComboBoxItem Content="Canvas limpio" />
                                    <ComboBoxItem Content="Instrumentacion de motor principal" />
                                </ComboBox>

                                <Grid Margin="0,2,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#0F1B2A" BorderBrush="#1D4E89" BorderThickness="1" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="Telemetria MQTT" Foreground="#6EE7B7" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="Topic visualiot/# preparado para ESP32." Foreground="#B7C6D8" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#11192A" BorderBrush="#7C3AED" BorderThickness="1" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="Dashboard libre" Foreground="#C4B5FD" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="Widgets editables con drag and drop." Foreground="#B7C6D8" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Background="#1B1A12" BorderBrush="#F59E0B" BorderThickness="1" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="Vista industrial" Foreground="#FCD34D" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="Indicadores pensados para motores y procesos." Foreground="#D6CDB2" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Button x:Name="CreateDashboardButton"
                                        Content="Crear dashboard"
                                        Height="46"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Background="#10B981"
                                        BorderBrush="#34D399"
                                        Click="CreateDashboardButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
