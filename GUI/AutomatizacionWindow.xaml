<Window x:Class="GUI.AutomatizacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualIoT - Automatizacion industrial"
        Height="760"
        Width="1240"
        MinHeight="660"
        MinWidth="1020"
        WindowStartupLocation="CenterOwner"
        Background="#071019"
        FontFamily="Segoe UI"
        FontSize="13.5">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F7FB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A7B7C8" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#72849A" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C141E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#101923" />
        <SolidColorBrush x:Key="CardBrush" Color="#13202C" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#182A3B" />
        <SolidColorBrush x:Key="FieldBrush" Color="#0B1420" />
        <SolidColorBrush x:Key="LineBrush" Color="#26384C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#28C7A4" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="IndustrialYellowBrush" Color="#F7C948" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F97316" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="26" Direction="270" ShadowDepth="5" Opacity="0.30" Color="#000000" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.22" Color="#000000" />
        <DropShadowEffect x:Key="AccentGlow" BlurRadius="18" Direction="0" ShadowDepth="0" Opacity="0.40" Color="#28C7A4" />
        <DropShadowEffect x:Key="CyanGlow" BlurRadius="18" Direction="0" ShadowDepth="0" Opacity="0.34" Color="#38BDF8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#1C2A3A" />
            <Setter Property="BorderBrush" Value="#35506F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#23435D" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#102033" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="BorderBrush" Value="#2DD4BF" />
            <Setter Property="Foreground" Value="#DFFCF6" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B1D24" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FECACA" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#111D2A" />
            <Setter Property="BorderBrush" Value="#2A3C51" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Chrome" Property="Background" Value="#0E1A28" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4B6584" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CleanListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="BackgroundPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PulseRingA" Storyboard.TargetProperty="Opacity" From="0.12" To="0.36" Duration="0:0:3.0" />
            <DoubleAnimation Storyboard.TargetName="PulseRingB" Storyboard.TargetProperty="Opacity" From="0.08" To="0.28" Duration="0:0:3.6" />
            <DoubleAnimation Storyboard.TargetName="SignalLineA" Storyboard.TargetProperty="Opacity" From="0.14" To="0.50" Duration="0:0:2.6" />
            <DoubleAnimation Storyboard.TargetName="SignalLineB" Storyboard.TargetProperty="Opacity" From="0.10" To="0.40" Duration="0:0:2.9" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource BackgroundPulse}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#061019" Offset="0" />
                <GradientStop Color="#0A1622" Offset="0.46" />
                <GradientStop Color="#07121B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Width="1280" Height="820" Canvas.Left="-40" Canvas.Top="-30" Opacity="0.12">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#38BDF8" Thickness="0.8" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="48,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,48" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse x:Name="PulseRingA" Width="380" Height="380" Canvas.Left="-130" Canvas.Top="80" Stroke="#28C7A4" StrokeThickness="2" Opacity="0.16" />
            <Ellipse x:Name="PulseRingB" Width="560" Height="560" Canvas.Left="860" Canvas.Top="-140" Stroke="#38BDF8" StrokeThickness="1.4" Opacity="0.12" />
            <Line x:Name="SignalLineA" X1="70" Y1="650" X2="420" Y2="230" Stroke="#28C7A4" StrokeThickness="2" Opacity="0.20" />
            <Line x:Name="SignalLineB" X1="740" Y1="80" X2="1120" Y2="430" Stroke="#F7C948" StrokeThickness="1.4" Opacity="0.16" />
            <Path Stroke="#24445C" StrokeThickness="1.2" Opacity="0.38" Data="M 22 706 L 180 706 L 210 676 L 332 676 L 370 638 L 520 638" />
            <Path Stroke="#24445C" StrokeThickness="1.2" Opacity="0.32" Data="M 644 58 L 790 58 L 820 88 L 950 88 L 980 118 L 1100 118" />
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#E60C141E" BorderBrush="#1D2C3D" BorderThickness="0,0,0,1" Effect="{StaticResource SoftShadow}">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="52" Height="52" Margin="0,0,16,0">
                            <Ellipse Fill="#102538" Stroke="#2DD4BF" StrokeThickness="1.2" />
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="23" Effect="{StaticResource AccentGlow}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Automatizacion industrial" Foreground="{StaticResource IndustrialYellowBrush}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Reglas, condiciones, acciones y eventos SCADA/IoT" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#102538" BorderBrush="#254B64" BorderThickness="1" CornerRadius="10" Padding="14" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#123A35" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="8">
                                <TextBlock Text="PLC" Foreground="#BDF8ED" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Motor de reglas" FontWeight="SemiBold" />
                                <TextBlock Text="Validacion y monitoreo activo" Foreground="{StaticResource MutedTextBrush}" FontSize="12.5" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#3B4D63" BorderThickness="1" CornerRadius="13" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock Text="RULE ENGINE" Foreground="#BAE6FD" FontSize="10.5" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="410" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Effect="{StaticResource SoftShadow}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="SCADA RULES" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="Panel de control" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,20" />

                            <Border Background="#0F1F2D" BorderBrush="#25445C" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBlueBrush}" FontSize="17" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Dashboard" Foreground="{StaticResource DimTextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DashboardLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#0F1F2D" BorderBrush="#25445C" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="17" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Reglas" Foreground="{StaticResource DimTextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RuleCountText}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#0F1F2D" BorderBrush="#25445C" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource IconText}" Foreground="{StaticResource IndustrialYellowBrush}" FontSize="17" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Activas" Foreground="{StaticResource DimTextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActiveRuleCountText}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#0E1B28" BorderBrush="#26384C" BorderThickness="1" CornerRadius="9" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="Modo" Foreground="{StaticResource DimTextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Dark industrial" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock Text="Contraste revisado para condiciones, acciones y alertas." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Background="#102538" BorderBrush="#254B64" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Effect="{StaticResource AccentGlow}" />
                                <TextBlock Grid.Column="1" Text="Automatizacion lista" Foreground="{StaticResource MutedTextBrush}" FontSize="12.5" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="#E6101923" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Effect="{StaticResource SoftShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#123A35" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="8">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="15" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Configurar regla" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Text="SI un sensor cumple una condicion, ENTONCES ejecuta una accion." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="NOMBRE" Style="{StaticResource CaptionText}" />
                            <TextBox x:Name="RuleNameTextBox" Text="Temperatura critica" Margin="0,0,0,14" />

                            <TextBlock Text="DESCRIPCION" Style="{StaticResource CaptionText}" />
                            <TextBox x:Name="DescriptionTextBox" Text="Alerta por temperatura fuera de rango" Margin="0,0,0,14" />

                            <TextBlock Text="SENSOR TAGDATA" Style="{StaticResource CaptionText}" />
                            <ComboBox x:Name="TagComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="IdTag" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OPERADOR" Style="{StaticResource CaptionText}" />
                                    <ComboBox x:Name="OperatorComboBox" SelectedIndex="0">
                                        <ComboBoxItem Content="&gt;" />
                                        <ComboBoxItem Content="&lt;" />
                                        <ComboBoxItem Content="&gt;=" />
                                        <ComboBoxItem Content="&lt;=" />
                                        <ComboBoxItem Content="=" />
                                        <ComboBoxItem Content="==" />
                                        <ComboBoxItem Content="!=" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VALOR UMBRAL" Style="{StaticResource CaptionText}" />
                                    <TextBox x:Name="ThresholdTextBox" Text="90" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="SEVERIDAD" Style="{StaticResource CaptionText}" />
                            <ComboBox x:Name="SeverityComboBox" SelectedIndex="0" Margin="0,0,0,14">
                                <ComboBoxItem Content="Critica" />
                                <ComboBoxItem Content="Advertencia" />
                                <ComboBoxItem Content="Normal" />
                            </ComboBox>

                            <Border Background="#0F1F2D" BorderBrush="#25445C" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,18">
                                <CheckBox x:Name="ActiveCheckBox" Content="Regla activa y lista para disparar eventos" IsChecked="True" />
                            </Border>

                            <UniformGrid Columns="2" Rows="2">
                                <Button x:Name="CreateRuleButton" Click="CreateRuleButton_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Crear" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="EditRuleButton" Click="EditRuleButton_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,8" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Editar" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearButton" Click="ClearButton_Click" Style="{StaticResource QuietButton}" Margin="0,8,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Limpiar" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteRuleButton" Click="DeleteRuleButton_Click" Style="{StaticResource DangerButton}" Margin="8,8,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Eliminar" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="4" Background="#E6101923" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Effect="{StaticResource SoftShadow}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reglas del dashboard" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Tarjetas activas con sensor, condicion, severidad y estado" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#102F2B" BorderBrush="#236E62" BorderThickness="1" CornerRadius="14" Padding="11,5" VerticalAlignment="Top">
                                <TextBlock Text="{Binding ActiveRuleCountText}" Foreground="#8EF6D2" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <ListBox x:Name="RulesListBox"
                                 ItemsSource="{Binding Rules}"
                                 SelectionChanged="RulesListBox_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 ItemContainerStyle="{StaticResource CleanListBoxItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RuleCard"
                                            Background="{StaticResource CardBrush}"
                                            BorderBrush="#31475E"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Effect="{StaticResource CardShadow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="116" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" Background="{Binding SeverityBadgeBrush}" BorderBrush="{Binding SeverityBrush}" BorderThickness="1" CornerRadius="9" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding SeverityIcon}" Foreground="{Binding SeverityBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,9" />
                                                <WrapPanel>
                                                    <Border Background="#0D141D" BorderBrush="#2B3B50" BorderThickness="1" CornerRadius="12" Padding="9,5" Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding SensorText}" Foreground="#D7E2EC" FontWeight="SemiBold" FontSize="12.5" />
                                                    </Border>
                                                    <Border Background="#0D141D" BorderBrush="#2B3B50" BorderThickness="1" CornerRadius="12" Padding="9,5" Margin="0,0,8,6">
                                                        <TextBlock Text="{Binding ConditionText}" Foreground="#D7E2EC" FontWeight="SemiBold" FontSize="12.5" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <Border Background="{Binding SeverityBadgeBrush}" BorderBrush="{Binding SeverityBrush}" BorderThickness="1" CornerRadius="12" Padding="9,5" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Severidad}" Foreground="{Binding SeverityBrush}" FontWeight="Bold" FontSize="12.5" />
                                                </Border>
                                                <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding StatusBrush}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,13,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="RuleCard" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                            <Setter TargetName="RuleCard" Property="BorderBrush" Value="#38BDF8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="RuleCard" Property="Background" Value="#152D3C" />
                                            <Setter TargetName="RuleCard" Property="BorderBrush" Value="#28C7A4" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#E60B141E" BorderBrush="#1E2C3A" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTextBlock" Text="Listo" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Sistema listo" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="NotificationBorder"
                Width="430"
                Background="#F0123B36"
                BorderBrush="#28C7A4"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,118,28,0"
                Opacity="0"
                Visibility="Collapsed"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="#102538" VerticalAlignment="Top">
                    <TextBlock x:Name="NotificationIconTextBlock" Text="&#xE930;" Style="{StaticResource IconText}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Automatizacion" FontWeight="SemiBold" />
                    <TextBlock x:Name="NotificationTextBlock" Text="Regla guardada correctamente." Foreground="#DFFCF6" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
