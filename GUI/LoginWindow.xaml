<Window x:Class="GUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualIoT - Acceso"
        Height="620"
        Width="900"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1018"
        FontFamily="Segoe UI"
        FontSize="13.5">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F7FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A8B6C7" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="#F7FAFC" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#33455F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="#121826" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#33455F" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="#F7FAFC" />
            <Setter Property="Background" Value="#101722" />
            <Setter Property="BorderBrush" Value="#33455F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Foreground" Value="#F7FAFC" />
            <Setter Property="Background" Value="#128F7C" />
            <Setter Property="BorderBrush" Value="#2DD4BF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#16A38F" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#5EEAD4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0F766E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1018" Offset="0" />
                <GradientStop Color="#101827" Offset="0.58" />
                <GradientStop Color="#0A1420" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="680" MaxWidth="680" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#121A27"
                BorderBrush="#315070"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#172235" BorderBrush="#315070" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="28,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="VisualIoT" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="Acceso de usuario al monitoreo industrial."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#123D45"
                                BorderBrush="#2DD4BF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="14,8"
                                VerticalAlignment="Top">
                            <TextBlock Text="MQTT READY" FontWeight="Bold" FontSize="12" Foreground="#DFFCF7" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="28">
                    <TextBlock Text="Email" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="EmailTextBox" Text="admin@visuallot.com" FontSize="15" />

                    <TextBlock Text="Contrasena" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,18,0,7" />
                    <PasswordBox x:Name="PasswordBox" FontSize="15" />

                    <TextBlock x:Name="LoginStatusTextBlock"
                               Text=""
                               Foreground="#FF6A6A"
                               TextWrapping="Wrap"
                               Margin="0,14,0,18" />

                    <Button x:Name="LoginButton"
                            Content="Ingresar al dashboard"
                            Click="LoginButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
